<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RootNamespace>ArmorDurabilityMultiplier</RootNamespace>
    <Version>1.0.0</Version>
    <Product>Armor-Durability-Multiplier</Product>
    <Description>Multiplies armor material durability (normal and explosion) in SPT Globals.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SPTushonka.Common" Version="4.1.6" />
    <PackageReference Include="SPTushonka.DI" Version="4.1.6" />
    <PackageReference Include="SPTushonka.Server.Core" Version="4.1.6" />
  </ItemGroup>

  <ItemGroup>
    <_ContentIncludedByDefault Remove="dist\package.json" />
    <Content Update="config.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <SptModsDir>D:\Tarkov\SPT_Runtime\user\mods</SptModsDir>
  </PropertyGroup>

  <!-- Копирует собранный мод прямо в папку модов SPT. Перезаписывает установленный config.json. -->
  <Target Name="DeployToSpt" AfterTargets="Build" Condition="Exists('$(SptModsDir)')">
    <Copy SourceFiles="$(TargetPath);$(TargetDir)config.json" DestinationFolder="$(SptModsDir)\$(AssemblyName)" />
    <Message Text="--- Deployed server mod to $(SptModsDir)\$(AssemblyName) ---" Importance="high" />
  </Target>
</Project>
